# Relying-party id from the World Developer Portal.
WORLDID_RP_ID=

# The action the proof must be bound to. A proof minted for a different action
# of the same RP is refused.
WORLDID_ACTION=

# v4 lives on world.org, not worldcoin.org. Override only for staging.
WORLDID_VERIFY_BASE_URL=https://developer.world.org/api/v4/verify
WORLDID_VERIFY_TIMEOUT_MS=8000

GATE_PORT=8787
GATE_DB_PATH=./data/nullifiers.db

# Leave this unset. "true" lets World App satisfy the request with a v3
# (legacy) proof, and a v3 proof carries a DIFFERENT nullifier than a v4 proof
# for the same person. One human, two nullifiers, two welcome credits, and
# every uniqueness check still reports success.
GATE_ALLOW_LEGACY_PROOFS=

# The RP signing key is NOT read by this service. See README.

# The credential World must say was actually presented, e.g. `selfie`.
# Leave unset until one real proof has been observed: the gate logs
# `credentials=[...]` on every success, and that log is what tells you the
# right value. Setting it before then can refuse every claimant.
GATE_REQUIRE_CREDENTIAL=
